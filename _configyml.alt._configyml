---
version: 4.2.2
# This config file is meant for settings that affect your whole blog, values
# which you are expected to set up once and rarely edit after that. If you find
# yourself editing this file very often, consider using data files

# If you change this file, please restart the server process.
#
# If you need help with YAML syntax, here are some quick references for you:
# https://learn-the-web.algonquindesign.ca/topics/markdown-yaml-cheat-sheet/#yaml
# https://learnxinyminutes.com/docs/yaml/
title: in love we trust
description: >- # this means to ignore newlines
 things I worked through to make sure I understand.

#baseurl             : "" # does not include hostname
##baseurl: "" # the subpath of your site, e.g. /blog
url_base: "/yarn" # the subpath of your site, e.g. /blog
##url: "/" # the base hostname & protocol for your site
#url:

## Serving
#detach              : false
#port                : 4000
#host                : 127.0.0.1
#show_dir_listing    : false

show_description: false

#source: DIR

disable_disk_cache: true

## Gems
## Plugins
#whitelist           : []
#plugins             : []
plugins:
  - jekyll-avatar
  - jekyll-feed                 # automatically generate an Atom feed at /feed.xml
  - jekyll-mentions
  - jekyll-sitemap
  - jemoji
  # - jekyll-feed
  # - jekyll-sitemap
  - jekyll-redirect-from
  - jekyll-seo-tag
#- jekyll-github-metadata
#- rouge
#- jekyll-html-pipeline

## Exclude from processing.
## exclude: [DIR, FILE, ...]
##exclude: ["README.md"]
# Any item listed under the `exclude:` key here will be automatically added to
# the internal "default list".
#
# Excluded items can be processed by explicitly listing the directories or
# their entries' file path in the `include:` list.

# The following items will not be processed, by default. Create a custom list
# to override the default setting.
#exclude             : ["Gemfile", "Gemfile.lock", "node_modules", "vendor/bundle/", "vendor/cache/", "vendor/gems/", "vendor/ruby/"]
# exclude:
#   - .sass-cache/
#   - .jekyll-cache/
#   - gemfiles/
#   - Gemfile
#   - Gemfile.lock
#   - node_modules/
#   - vendor/bundle/
#   - vendor/cache/
#   - vendor/gems/
#   - vendor/ruby/
exclude:
  - CHANGELOG.md
  - HOW_TO_RELEASE.md
  - Gemfile
  - Gemfile.lock
  - LICENSE
  # - /screenshots
  #- /index.html
  #- README-*.md
  #- README.md
  #- readme.md
  - gulpfile.js
  - package-lock.json
  - package.json
  - /node_modules
  - /test
  - /vendor

#keep_files          : [".git", ".svn"]

# If you want to link only specific pages in your header, uncomment
# this and add the path to the pages in order as they should show up
#header_pages:
# - about.md
# ########

collections:
  note:
    # Default is "/:path/"
    #for collections, :collection is part of path
    permalink: /:collection/:title/
    output: true
  posts:
    #permalink: /:collection/:path/
    permalink: /:collection/:title/
    #output: true

#defaults            : []
defaults:
  - scope:
      path: '' # an empty string here means all files in the project
    values:
      layout: post
      #layout: page
      # types available are pages, posts, or any collection, in plural form
      type: posts
      # The 'post' type has become 'posts'.
      category: "journal"
      image: "/img/jekyll-og.png"
      #permalink: /:title/
  - scope:
      path: _note
      type: "notes"
    values:
      layout: page
      category: "ramblings"

  -
    scope:
      path: "projects"
      type: "pages" # previously `page`
    values:
      layout: "project" # overrides previous default layout
      author: "Mr. Poole"
  - scope:
      path: "img"
    values:
      image: true

#data_dir: /docs/_data
#collections_dir: docs
  - scope:
      path: _docs
      type: docs
    values:
      layout: article
      sharing: true
      license: true
      category: post
      aside:
        toc: true
      show_edit_on_github: true
      show_subscribe: true
      pageview: true
      lightbox: true
  ## docs
  - scope:
      path: "_docs/en"
    values:
      layout: article
      nav_key: docs
      sidebar:
        nav: docs-en
      license: true
      aside:
        toc: true
      show_edit_on_github: true
      show_date: false
      lightbox: true
  - scope:
      path: "_docs/zh"
    values:
      layout: article
      nav_key: docs
      sidebar:
        nav: docs-zh
      license: true
      aside:
        toc: true
      lang: zh
      show_edit_on_github: true
      show_date: false
      lightbox: true


## Outputting
#permalink           : date
#permalink: /:slug/
#permalink: /:title/
## pages and collections (excluding posts and drafts) don’t have time
## and categories (for pages, the above :title is equivalent to :basename),
## these aspects of the permalink are ignored for the output.


#timezone            : null
#lang: # the language of your site, default as "en"
#lang: "en"
#timezone: # see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones for the available values
timezone: America/Los_Angeles

# This can be in front matter of each markdown file
#mermaid: true

navs:
  -
    href: /
    label: DEN

  -
    href: /note/
    label: DROP

  -
    href: /about/
    label: AMA

#rss: rss
#rss: "feed.xml"
rss: "/feed.xml"
####
#subscribe_rss: /feed.xml
####

# <p class="rss-subscribe">subscribe <a href="{{ '/feed.xml' | relative_url }}">via RSS</a></p>

#feed:
  #categories:
  #- release

# goat_counter: "yoursitename" # put your GoatCounter name if you want to use GoatCounter analytics

appearance: "dark" # can be "light", "dark" or "auto"
#back_home_text: "$title" # customize text for homepage link in post layout

########
# refer to http://shopify.github.io/liquid/filters/date/ if you want to customize this
thepro:
  date_format: "%Y%m%d"
date_format: "ordinal"
########
date_format: "%Y%m%d" # customize how date is formatted
##date_format: "%b %d, %Y"

algolia:
  application_id: 8A9B3KASX2
  index_name:     jekyll # You can replace that with whatever name you want
  search_only_api_key: d1b7336f6715c79e548902a41754aa23


#encoding            : "utf-8"
#markdown_ext        : "markdown,mkdown,mkdn,mkd,md"
#strict_front_matter : false
strict_front_matter: true


# Filtering Content
show_drafts         : null
limit_posts         : 0
#future              : false
future: true
#unpublished         : false


## Conversion
#markdown            : kramdown
#highlighter         : rouge
#lsi                 : false

## excerpt
#excerpt_separator   : "\n\n"
#excerpt_separator: <!--more-->
show_excerpt: false

#incremental         : false

#quiet               : false
#verbose             : false

liquid:
  ##error_mode        : lax
  #strict_filters    : false
  #strict_variables  : false
##Do note that while error_mode configures Liquid’s parser, the strict_variables and strict_filters options configure Liquid’s renderer and are consequently orthogonal.
  #error_mode        : warn
  error_mode        : warn
  #error_mode: strict
########
  #strict_variables: true
########
  strict_filters: true
#_includes/algolia.html
#######
#render_with_liquid: "false"
#######


## Markdown Processors
kramdown:
  #auto_ids          : true
  #entity_output     : as_char
  #toc_levels        : [1, 2, 3, 4, 5, 6]
  #smart_quotes      : lsquo,rsquo,ldquo,rdquo
  #input             : GFM
  #hard_wrap         : false
  #footnote_nr       : 1
  #header_offset: 2
  #show_warnings     : false
  #syntax_highlighter: rouge
  syntax_highlighter_opts:
    default_lang: plaintext

  #syntax_highlighter: coderay
  #syntax_highlighter_opts:
    #line_numbers: table
    #bold_every: 5


text_skin: default # "default" (default), "dark", "forest", "ocean", "chocolate", "orange"
highlight_theme: default # "default" (default), "tomorrow", "tomorrow-night", "tomorrow-night-eighties", "tomorrow-night-blue", "tomorrow-night-bright"


## => Author and Social
##############################
author:
  type      : organization # "person" (default), "organization"
  url       :
  avatar    : /img/apple-touch-icon.png
  bio: >
    Tefor development.
  email     : 1
  telegram  : 1
  medium    : 1
  linkedin  : 1
  github    : ashang
  npm       : 1
#####name: Aaron Shang
#email: Kea Wot <aaron@ashang.org>
#github_username: ashang
github_username: ashang
## linkedin_username:

## => GitHub Repository (if the site is hosted by GitHub)
##############################
#repository:
#repository_tree: main


## => Paths
##############################
paths:
  root    : # title link url, "/" (default)
  home    : /test/ # home layout url, "/" (default)
  archive : # "/archive.html" (default)
  rss     : # "/feed.xml" (default)


## license
license: CC-BY-4.0 # "CC-BY-4.0", "CC-BY-SA-4.0", "CC-BY-NC-4.0", "CC-BY-ND-4.0"


## TOC
toc:
  selectors: "h1,h2,h3,h4,h5,h6" # "h1,h2,h3" (default)


## => Markdown Enhancements
##############################
## Mathjax
mathjax: true # false (default), true
mathjax_autoNumber: true # false (default), true

## Mermaid
mermaid: true # false (default), true

## Chart
chart: true # false (default), true


## => Sources
##############################
sources: unpkg # bootcdn (default), unpkg


## => Sharing
##############################
sharing:
  provider: addtoany # false (default), "addtoany", "addthis", "custom"

  ## AddThis
  addthis:
    id: # AddThis pubid, e.g. ra-5xxxxxxxxxxx


## => Comments
##############################
comments:
  provider: gitalk # false (default), "disqus", "gitalk", "valine", "custom"
  # provider: valine

  ## Disqus
  disqus:
    shortname: # the Disqus shortname for the site

  ## Gitalk
  # please refer to https://github.com/gitalk/gitalk for more info.
  gitalk:
    clientID    : 143666b578a416f82175
    clientSecret: 1d1c0604a1a4bff9b59ab7f56724dc0e8b837775
    repository  : gitalk-demo
    owner       : ashang
    #admin: # GitHub repo owner and collaborators, only these guys can initialize GitHub issues, IT IS A LIST.
    admin:
      - ashang

  ## Valine
  # please refer to https://valine.js.org/en/ for more info.
  valine:
    app_id      : uAG3OhdcH8H4fxSqXLyBljA7-gzGzoHsz
    app_key     : Mzf5m9skSwYVWVXhGiYMNyXs
    placeholder : # Prompt information
    visitor     : # false (default)
    meta        : # "[nick, mail, link]" (default) nickname, E-mail, Personal-site

## => Pageview
##############################
pageview:
  provider: leancloud # false (default), "leancloud", "custom"

  ## Leancloud
  leancloud:
    app_id    : uAG3OhdcH8H4fxSqXLyBljA7-gzGzoHsz
    app_key   : Mzf5m9skSwYVWVXhGiYMNyXs
    app_class : TeXtDemo


## => Search
##############################
search:
  provider: default # "default" (default), false, "google", "custom"

  ## Google Custom Search Engine
  google:
    # custom_search_engine_id: 017643444788069204610:4gvhea_mvga # Google Custom Search Engine ID


## => Analytics
##############################
analytics:
  provider: google # false (default), "google", "custom"

  ## Google Analytics
  google:
    tracking_id : UA-71907556-1
    anonymize_ip: false # Anonymize IP tracking for Analytics

# google_analytics_id: #"UA-NNNNNNNN-N"
#google_analytics: ""
#google_site_verification: onQcXpAvtHBrUI5LlroHNE_FP0b2qvFyPq7VZw36iEY
#cloudinary_url: https://res.cloudinary.com/jekyll/image/upload/f_auto,q_auto,w_404


# Favicon
#favicon: images/favicon.png
favicon: "img/t.svg" # name+extension of favicon (which must be put on the root folder)

# Site navigation - each item must have a title and a url.
navigation:
  - text: Home
    url: /
  - text: About
    url: /about/
  - text: Drop
    url: /drop/
  - text: yarn
    url: /yarn/
  - text: pages
    url: /pages/
  - text: Docs
    url: /docs/
  - text: Tags
    url: /tags/

# The shortname for your Disqus site to enable comments.
#disqus:

## Colors
#accent_color: '#2d72d9'

# Site footer
footer:
  content: "&copy; some rights reserved."
  has_social: true

# Sass
sass:
  sass_dir: _sass
  style: compressed
