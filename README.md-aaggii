void _sys_driver_init(struct sys_driver_ops* driver){
    static bool inited = false;
    if (inited) {
        return;
    }
    _sys_driver_init_default(driver);

    string platform;
    pica_get_platform(platform);

    if (platform == "niagara2632xl") {
        sys_driver_init_2632(driver);
    } else if (platform == "niagara2948-6xl") {
        sys_driver_init_2948(driver);
    } else if (platform == "3290") {
        sys_driver_init_3290(driver);
    } else if (platform == "3295") {
        sys_driver_init_3295(driver);
    } else if (platform == "3296") {
        sys_driver_init_3296(driver);
    } else if (platform == "3780") {
        sys_driver_init_3780(driver);
    } else if (platform == "3920") {
        sys_driver_init_3920(driver);
    } else if (platform == "3922") {
        sys_driver_init_3922(driver);
    } else if (platform == "3924") {
        sys_driver_init_3924(driver);
    } else if (platform == "3930") {
        sys_driver_init_3930(driver);
    } else if (platform == "as4610_54p" ||
             platform == "as4610_54t" ||
             platform == "as4610_30p" ||
             platform == "as4610_30t") {
        sys_driver_init_4610(driver);
    } else if (platform == "es4654bf") {
        sys_driver_init_4654(driver);
    } else if (platform == "5101") {
        sys_driver_init_5101(driver);
    } else if (platform == "5401") {
        sys_driver_init_5401(driver);
    } else if (platform == "as5712_54x") {
        sys_driver_init_5712(driver);
    } else if (platform == "as6701_32x") {
        sys_driver_init_6701(driver);
    } else if (platform == "dcs7032q28") {
        sys_driver_init_7032(driver);
    } else if (platform == "as6712_32x") {
        sys_driver_init_6712(driver);
    }else if (platform == "as7712_32x") {
        sys_driver_init_7712(driver);
    } else if (platform == "s4048") {
        sys_driver_init_4048(driver);
    } else if (platform == "arctica4806xp") {
        sys_driver_init_4806(driver);
    } else {
    } else if (platform == "as5812_54t") {
        sys_driver_init_5812(driver);
    }  else {
        printf("Driver init failed,unknown platform %s!\n",
            platform.c_str());
        return;
    }

    if (platform != "5401" &&
        platform != "as6701_32x" &&
        platform != "niagara2632xl" &&
        platform != "dcs7032q28" &&
        platform != "as6712_32x" &&
        platform != "as4610_54p" &&
        platform != "as4610_54t" &&
        platform != "as4610_30p" &&
        platform != "as4610_30t" &&
        platform != "as7712_32x") {

        driver->index_to_port = _index_to_port;
        driver->port_to_index = _port_to_index;
    }

    if (platform != "3290" &&
        platform != "3295" &&
        platform != "3296" &&
        platform != "3780" &&
        platform != "5401" &&
        platform != "as6701_32x" &&
        platform != "niagara2632xl" &&
        platform != "as6712_32x"){
        driver->check_interface_validity = _check_interface_validity;
    }

    if (platform != "3290" &&
        platform != "3295" &&
        platform != "3780" &&
        platform != "3920" &&
        platform != "dcs7032q28" &&
        platform != "as7712_32x"){
        driver->set_system_led= _set_system_led;
    }

    inited = true;
}

static struct sys_driver_ops *_pica_sys_driver(){
    static struct sys_driver_ops _sys_driver;
    static bool _initialised = false;

    if (!_initialised){
        _sys_driver_init(&_sys_driver);
    }
    return &_sys_driver;
}

bool pica_check_interface_validity(const string& ifname, QePortMode mode) {
    return _pica_sys_driver()->check_interface_validity(ifname, mode);
}

static bool _check_interface_validity(const string& ifname, int mode) {
    usp_t usp;

    if (!ifname_to_usp(ifname, usp)) {
        return false;
    }

    if (mode == QE_PORT_MODE_QE) {
        string platform;
        if (pica_get_platform(platform) &&
            platform != "as4610_30p" &&
            platform != "as4610_30t" &&
            platform != "as4610_54p" &&
            platform != "as4610_54t") {

            if (ifname.find(TEPORTPREFIX) == 0 &&
                usp.port() > (DEV_RJ45_COUNT+DEV_SFP_COUNT)) {
                return false;
            }
        }
    } else if (mode == QE_PORT_MODE_TE) {
        if (ifname.find(QEPORTPREFIX) == 0 || ifname.find(HEPORTPREFIX) == 0)  {
            return false;
        }
    }

    return true;
}

